// Priors and rules file  
// *********************  
[PARAMETERS]  
//#isInt? #name #dist.#min #max  
//all Ns are in number of haploid individuals  
1 AFR_N0 unif 400 200000 output bounded
1 EUR_N0 unif 400 200000 output bounded
1 ASIA_N0 unif 400 200000 output bounded
1 NAT_N0 unif 400 200000 output bounded
1 ADMIX_N0 unif 400 200000 output bounded
1 AFR_ABS_N1 unif 400 200000 output bounded
1 ASIA_ABS_N1 unif 100 200000 output bounded
1 EUR_ABS_N1 unif 100 200000 output bounded
1 EUR_ABS_N2 unif 400 200000 output bounded
1 T1 unif 5 50 output bounded
1 T2 unif 500 800 output bounded
1 T3 unif 800 1000 output bounded
1 T4 unif 5400 5800 output bounded
1 T5 unif 8600 9000 output bounded
0 EUR_G unif 0.001 0.05 output bounded
0 ASIA_G unif 0.001 0.05 output bounded
0 AM1 unif 0.05 0.80 output bounded
0 AM2 unif 0.05 0.80 output bounded

 
[COMPLEX PARAMETERS]  
0 AFR_N1 = AFR_ABS_N1/AFR_N0 hide  
0 AM_TMP = 1 - AM1 hide
0 AMPAR2 = AM_TMP * AM2 hide
0 EUR_NG = 0 - EUR_G hide
0 ASIA_NG = 0 - ASIA_G hide
